#!/bin/bash

echo "Cleaning up wappspector files..."

# Remove the wrapper script
rm -f /usr/local/bin/ea-wappspector

# Remove build artifacts that weren't tracked by RPM
if [ -d "/var/cpanel/wappspector" ]; then
    rm -rf /var/cpanel/wappspector/.composer
    rm -f /var/cpanel/wappspector/composer.phar
    rm -f /var/cpanel/wappspector/composer.lock
    rm -rf /var/cpanel/wappspector/vendor
    rm -f /var/cpanel/wappspector/wappspector.phar
fi