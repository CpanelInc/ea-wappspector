#!/bin/bash

# Only clean up untracked files after actual removal, not upgrade
if [ "$1" = "0" ]; then
    echo "Cleaning up remaining wappspector artifacts..."
    
    if [ -d "/opt/cpanel/ea-wappspector" ]; then
        rm -rf /opt/cpanel/ea-wappspector/.composer
        rm -rf /opt/cpanel/ea-wappspector/vendor
        rm -f /opt/cpanel/ea-wappspector/composer.phar
        rm -f /opt/cpanel/ea-wappspector/composer.lock
        rm -f /opt/cpanel/ea-wappspector/wappspector.phar
    fi
fi